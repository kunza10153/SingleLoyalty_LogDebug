{"domain":"RWD","level":"DEBUG","prdType":"PREPAID","appVersion":"11.0502.0","ssId":"70a6ce67-6-3--89-8-28-228ac9e98-","logger":"org.hibernate.SQL","reqIP":"127.0.0.1","app":"trueapp-commonbe-reward","brand":"TMH","zone":"UAT","filename":"/var/log/containers/trueapp-commonbe-reward-deploy-b996d46fc-p8vp6_trueapp_main-72730958e693ac21dea193e3878d32024f497c6ccb48b28742abb3483925881c.log","segment":"TUC","sourceSystem":"trueapp","reqTxId":"trueapp20260520093553254851","@timestamp":"2026-05-20T09:35:53.281+07:00","service_name":"trueapp-commonbe-reward","APIRefer":"-","mode":"Sync","digitalId":"9393c136f9348badefb0649a163be749","mainDigitalId":"9393c136f9348badefb0649a163be749","platform":"IOS","txId":"trueapp20260520093553256673","message":"\n    SELECT\n        b.section_id,\n        b.priority,\n        b.seq_no,\n        b.item_name,\n        a.brand_code,\n        b.item_icon,\n        b.item_image1x1,\n        b.item_image4x3,\n        b.item_image16x9,\n        b.item_image9x16,\n        b.item_type_code,\n        b.item_subtype,\n        b.shelf_type_code,\n        b.item_mapping,\n        b.item_mapping2,\n        b.dummy_flag,\n        (SELECT\n            s.item_display_name         \n        FROM\n            rwd_section_detail_display_name s         \n        WHERE\n            s.section_id = b.section_id           \n            AND  s.seq_no = b.seq_no           \n            AND  s.lang = ?) AS item_display_name,\n        (SELECT\n            s.item_display_name         \n        FROM\n            rwd_section_detail_display_name s         \n        WHERE\n            s.section_id = b.section_id           \n            AND  s.seq_no = b.seq_no           \n            AND  s.lang = 'EN') AS item_display_name_en,\n        (SELECT\n            rsdn.section_display_name         \n        FROM\n            rwd_section_display_name rsdn         \n        WHERE\n            rsdn.section_id = b.section_id           \n            AND  rsdn.lang = ?) AS section_display_name,\n        (SELECT\n            rsdn.section_display_name         \n        FROM\n            rwd_section_display_name rsdn         \n        WHERE\n            rsdn.section_id = b.section_id           \n            AND  rsdn.lang = 'EN') AS section_display_name_en,\n        (SELECT\n            rsdc.content         \n        FROM\n            rwd_section_detail_content rsdc         \n        WHERE\n            rsdc.section_id = b.section_id           \n            AND  rsdc.seq_no = b.seq_no           \n            AND  rsdc.lang = ?) AS content,\n        (SELECT\n            rsdc.content         \n        FROM\n            rwd_section_detail_content rsdc         \n        WHERE\n            rsdc.section_id = b.section_id           \n            AND  rsdc.seq_no = b.seq_no           \n            AND  rsdc.lang = 'EN') AS content_en \n    FROM\n        rwd_section a        \n    INNER JOIN\n        rwd_section_detail b \n            ON a.section_id = b.section_id \n    WHERE\n        a.section_id = ?   \n        AND  a.brand_code = ? \n    ORDER BY\n        b.priority","deviceId":"3E0CC7CA-5543-48C1-B0B6-4F9BDE40806C","pod_name":"trueapp-commonbe-reward-deploy-b996d46fc-p8vp6","APIName":"/v1/shelf/getSectionHeader.GET","thread":"http-nio-8081-exec-25"}
